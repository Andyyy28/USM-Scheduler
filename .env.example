SOLVER_DEFAULT_TIME_LIMIT_SECONDS=300
SOLVER_MEMORY_LIMIT_MB=2048
APP_BUILD_ID=local-development
SOURCE_COMMIT=uncommitted
CONTAINER_IMAGE_ID=usm-scheduler:local
